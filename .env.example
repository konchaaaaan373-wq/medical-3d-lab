# Browser-visible Supabase configuration (safe to expose in Vite bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback still supported:
# VITE_SUPABASE_ANON_KEY=

# Netlify Functions: Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallbacks still supported:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Netlify Functions: Stripe test/live keys. Prefer a least-privilege rk_* key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PATIENT=
STRIPE_PRICE_EDUCATION=
STRIPE_PRICE_COMPLETE=

# Public site origin. Without it the crawlable scene pages are still built, but
# canonical/Open Graph URLs are omitted and no sitemap is emitted rather than
# one full of guessed URLs. See docs/discoverability.md.
VITE_SITE_URL=

# Observability. All three are optional; with no endpoint configured nothing is
# transmitted at all — events are validated, redacted and dropped, and the
# feedback panel composes a mail message. See docs/observability.md.
# Both endpoints must be same-origin: the CSP in public/_headers allows
# connect-src 'self' and Supabase only.
VITE_TELEMETRY_ENDPOINT=
VITE_FEEDBACK_ENDPOINT=
VITE_RELEASE=

# Billing operations. Reconciliation refuses every request without a token
# rather than defaulting to open; alerts are logged when no channel is set.
# See docs/access-and-billing.md.
BILLING_RECONCILE_TOKEN=
OPS_ALERT_WEBHOOK=
DEPLOY_ENV=

# Optional: customers reconciled per hourly run (default 3, maximum 10).
BILLING_RECONCILE_BATCH_SIZE=3

# Fixed from the first failed subscription payment; retries do not extend it.
# Default 7, maximum 30. Set 0 to suspend paid access immediately.
BILLING_PAST_DUE_GRACE_DAYS=7
